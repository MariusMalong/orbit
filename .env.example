# Copy this file to .env and fill in the values.

# Local PostgreSQL (matches the docker run command in the README)
DATABASE_URL="postgresql://postgres:password@localhost:5432/orbit?schema=public"
# Used by `prisma migrate`. Locally it's the same as DATABASE_URL; on Neon it's
# the direct (non-pooled) connection string.
DIRECT_URL="postgresql://postgres:password@localhost:5432/orbit?schema=public"

# Auth.js: any long random string, e.g. the output of `openssl rand -base64 32`
AUTH_SECRET=""

# GitHub OAuth app (callback URL: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Optional Google OAuth client. The "Sign in with Google" button only shows
# when both are set. Authorised redirect URI:
# http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Needed when running a production build (`next start`) or deploying:
# AUTH_URL="http://localhost:3000"

# Protects the daily demo cleanup job (api/cron/cleanup-demos). Vercel sends
# it with each cron call; generate one with `openssl rand -hex 32`.
CRON_SECRET=
